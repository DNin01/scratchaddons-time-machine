{
  "name": "Scratch Addons Time Machine",
  "description": "Roll back the clock and see how Scratch Addons has changed.",
  "version": "0.0.1",
  "icons": {
    "256": "images/time-machine/icon.png"
  },

  "manifest_version": 3,
  "permissions": [
    "contextMenus",
    "storage"
  ],

  "action": {
    "default_popup": "ui/popup-pages.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
